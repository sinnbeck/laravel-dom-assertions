parameters:
    level: 5
    paths:
        - %rootDir%/../../../src
    tmpDir: build/phpstan
    checkOctaneCompatibility: true
    checkModelProperties: true
    # The Rector rules do not vary by Laravel version and the test matrix removes
    # rector/rector before analysing, so they are analysed separately via ./rector.neon.
    excludePaths:
        - %rootDir%/../../../src/Rector
